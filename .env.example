# Copy to .env and fill in OPENAI_API_KEY. Every value below can also be set as a
# regular environment variable, which takes precedence over this file.

# OpenAI (or any OpenAI-compatible endpoint).
# For OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and prefix model names
# with the provider, e.g. openai/gpt-4o-mini and openai/text-embedding-3-small.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: send embeddings to a different endpoint/key. Blank = same as above.
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Vector store: "local" (embedded, persisted to CHROMA_PERSIST_DIR) or "http" (Chroma server)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./.chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=company_docs

# Ingestion
PDF_DIR=./data/pdfs
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# Retrieval (to be tuned in the evaluation phase)
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.35

# Chat model calls: timeout per request (seconds) and automatic retries with backoff
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# RAG chain: max tokens of retrieved context sent to the LLM, and how many recent
# conversation turns (user + assistant) are used to rewrite follow-up questions
RAG_MAX_CONTEXT_TOKENS=3000
RAG_HISTORY_MAX_TURNS=6

# Streamlit UI -> API: backend URL and how long the UI waits for an answer (seconds)
API_BASE_URL=http://localhost:8080
UI_REQUEST_TIMEOUT_SECONDS=120

# HTTP API: comma-separated browser origins allowed by CORS ("*" = any origin), and the
# key required in the X-Admin-Key header for POST /ingest (blank = endpoint disabled)
API_CORS_ORIGINS=http://localhost:8501
ADMIN_API_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
