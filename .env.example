# Copy to .env and fill in OPENAI_API_KEY. Every value below can also be set as a
# regular environment variable, which takes precedence over this file.

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store: "local" (embedded, persisted to CHROMA_PERSIST_DIR) or "http" (Chroma server)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./.chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=company_docs

# Ingestion
PDF_DIR=./data/pdfs
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# Retrieval (to be tuned in the evaluation phase)
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.35

# Streamlit UI -> API
API_BASE_URL=http://localhost:8080

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
